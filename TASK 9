#include <iostream>
#include <iomanip>
using namespace std;

long long calculateFare(int zone, int hour) {
    if (zone < 1 || zone > 3 ||
        hour < 0 || hour > 23) {
        return -1;
    }

    long long fare = 0;

    switch (zone) {
        case 1:
            fare = 1000;
            break;

        case 2:
            fare = 2000;
            break;

        case 3:
            fare = 3000;
            break;
    }

    bool peak = (hour >= 8 && hour < 10) ||
                (hour >= 17 && hour < 20);

    if (peak) {
        fare += fare * 20 / 100;
    }

    return fare;
}

int main() {
    long long balance = 10000;

    int zones[] = {1, 2, 3, 1, 2};
    int hours[] = {7, 9, 11, 17, 20};

    for (int i = 0; i < 5; i++) {
        long long f = calculateFare(zones[i], hours[i]);

        if (f == -1) {
            cout << "Invalid Journey\n";
            continue;
        }

        if (balance - f >= 5000) {
            balance -= f;

            cout << "Fare: Rs "
                 << f / 100 << "."
                 << setw(2) << setfill('0')
                 << f % 100 << setfill(' ');

            cout << " Balance: Rs "
                 << balance / 100 << '\n';
        } else {
            cout << "Journey Denied\n";
        }
    }

    cout << "Total Collection: Rs "
         << (10000 - balance) / 100 << '\n';

    return 0;
}
