
#include <iostream>
#include <string>
using namespace std;

const double DA_RATE = 0.42;

class Staff {
protected:
    string name;
    int id;

public:
    Staff(string n, int i) : name(n), id(i) {}

    virtual double pay() const = 0;

    virtual void display() const {
        cout << "Name: " << name << endl;
        cout << "ID: " << id << endl;
    }

    virtual ~Staff() = default;
};

class Professor : public Staff {
private:
    double basic, research;

public:
    Professor(string n, int i, double b, double r)
        : Staff(n, i), basic(b), research(r) {}

    double pay() const override {
        return basic + basic * DA_RATE + research;
    }
};

class LabAssistant : public Staff {
private:
    double basic;

public:
    LabAssistant(string n, int i, double b)
        : Staff(n, i), basic(b) {}

    double pay() const override {
        return basic + basic * DA_RATE;
    }
};

class GuestFaculty : public Staff {
private:
    double hours, rate;

public:
    GuestFaculty(string n, int i, double h, double r)
        : Staff(n, i), hours(h), rate(r) {}

    double pay() const override {
        return hours * rate;
    }
};

int main() {
    Professor p("Arun", 101, 50000, 10000);
    LabAssistant l("Kumar", 102, 30000);
    GuestFaculty g("Ravi", 103, 40, 500);

    Staff* staff[] = {&p, &l, &g};

    for (Staff* s : staff) {
        cout << "Salary: " << s->pay() << endl;
    }

    return 0;
}


