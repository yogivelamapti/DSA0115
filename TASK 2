#include <iostream>
using namespace std;

constexpr int INNER_FARE = 1000;
constexpr int MIDDLE_FARE = 2000;
constexpr int OUTER_FARE = 3000;

constexpr int PEAK_SURCHARGE = 20;
constexpr long long MIN_BALANCE = 5000;

enum class Zone {
    Inner, Middle, Outer
};

int main() {
    Zone z = Zone::Middle;

    int fare = 0;

    switch (z) {
        case Zone::Inner:
            fare = INNER_FARE;
            break;

        case Zone::Middle:
            fare = MIDDLE_FARE;
            break;

        case Zone::Outer:
            fare = OUTER_FARE;
            break;
    }

    cout << "Base Fare: Rs " << fare / 100.0 << '\n';

    fare += fare * PEAK_SURCHARGE / 100;

    cout << "Peak Fare: Rs " << fare / 100.0 << '\n';

    cout << "Minimum Balance: Rs " << MIN_BALANCE / 100 << '\n';

    return 0;
}
