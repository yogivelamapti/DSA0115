
#include <iostream>
using namespace std;

int& highest(int marks[], int n) {
    int index = 0;

    for (int i = 1; i < n; i++) {
        if (marks[i] > marks[index]) {
            index = i;
        }
    }

    return marks[index];
}

int main() {
    int marks[5] = {75, 85, 90, 80, 70};

    cout << "Highest Mark: " << highest(marks, 5) << endl;

    highest(marks, 5) += 2;

    cout << "After Moderation: " << highest(marks, 5) << endl;

    return 0;
}
