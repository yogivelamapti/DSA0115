#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    int hour;

    long long balance = 10000;

    cout << "Enter journey hour: ";

    if (!(cin >> hour)) {
        cout << "Invalid input\n";

        cin.clear();
        cin.ignore(1000, '\n');

        return 0;
    }

    if (hour < 0 || hour > 23) {
        cout << "Invalid hour\n";
        return 0;
    }

    bool peak = (hour >= 8 && hour < 10) ||
                (hour >= 17 && hour < 20);

    long long fare = 2000;

    if (peak) {
        fare += fare * 20 / 100;
    }

    if (balance - fare >= 5000) {
        balance -= fare;

        cout << fixed << setprecision(2);

        cout << "Fare: Rs " << fare / 100.0 << '\n';

        cout << "Remaining Balance: Rs "
             << balance / 100.0 << '\n';
    } else {
        cout << "Insufficient Balance\n";
    }

    return 0;
}
