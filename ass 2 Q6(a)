
#include <iostream>
using namespace std;

class Time {
    int h, m;

public:
    Time(int hh, int mm) {
        h = hh;
        m = mm;
    }

    friend int minutesBetween(const Time& a, const Time& b);

    friend bool earlier(const Time& a, const Time& b);
};

int minutesBetween(const Time& a, const Time& b) {
    int t1 = a.h * 60 + a.m;
    int t2 = b.h * 60 + b.m;

    int diff = t1 - t2;

    if (diff < 0)
        diff = -diff;

    return diff;
}

bool earlier(const Time& a, const Time& b) {
    int t1 = a.h * 60 + a.m;
    int t2 = b.h * 60 + b.m;

    return t1 < t2;
}

int main() {
    Time departure(9, 45);
    Time arrival(13, 10);

    cout << minutesBetween(departure, arrival) << ' '
         << boolalpha
         << earlier(arrival, departure) << endl;

    return 0;
}
